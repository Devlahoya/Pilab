rules_version = '2';

// Reglas de seguridad de PiLab.
// Pégalas en Firebase → Firestore Database → Reglas, y presiona «Publicar».
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil: cada quien lee y escribe sólo el suyo.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.avatar in [1, 2, 3];
    }

    // Proyectos: el dueño hace todo; cualquiera puede leer los compartidos.
    match /projects/{id} {
      allow read: if resource.data.isPublic == true
        || (request.auth != null && resource.data.owner == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.isPublic == false
        && request.resource.data.kind in ['analisis', 'simulacion']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000;

      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.kind in ['analisis', 'simulacion']
        && request.resource.data.title.size() <= 200
        && request.resource.data.payload.size() < 900000;

      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
