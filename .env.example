# Copia este archivo como .env.local y llena los valores de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → App web).
# En Netlify, agrega las mismas variables en Site configuration → Environment variables.
# Estas claves NO son secretas: identifican tu proyecto; la seguridad la dan las reglas de Firestore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
